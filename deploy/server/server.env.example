# EduJobs v2 block appended to /opt/n8n-project/.env (Workflow A spec Section 22.1).
# No secrets: credentials live in n8n. Keep the existing lines of that .env unchanged.

# Filled by the user: the new workbook and its application tab (shared by A and B).
GOOGLE_SHEETS_DOCUMENT_ID=
GOOGLE_SHEETS_SHEET_NAME=

# Workflow A (spec Section 18).
ELIGIBILITY_MODEL=gpt-6-luna
EDITOR_MODEL=gpt-6-luna
VALIDATOR_MODEL=gpt-6-luna
VALIDATOR_REASONING_EFFORT=high
MAX_LLM_SOURCE_CHARS=50000
MAX_EXTRACTED_CHARS=200000
# Shared with Workflow B; keep one value.
MAX_PUBLICATION_DESCRIPTION_CHARS=900
WORKFLOW_VERSION=workflow-a-v2.3.1-server
CONFIG_VERSION=server-2026-10-24-gpt-6-luna

# content-worker limits.
FETCH_TIMEOUT_SECONDS=15
MAX_REDIRECTS=3
MAX_DOWNLOAD_BYTES=10000000

# Workflow B (spec Section 21). Tabs use the defaults (Review Queue, Archive, Control, ...).
WORKFLOW_B_MODE=run
WORKFLOW_B_VERSION=workflow-b-presentation-v5
WORKFLOW_B_CONFIG_VERSION=presentation-v5-visible-900
# Test channel first; the user switches this to the production channel.
WORKFLOW_B_TELEGRAM_CHAT_ID=
# The production bot (n8n credential "Telegram account"), administrator of both channels.
WORKFLOW_B_TELEGRAM_EXPECTED_BOT_ID=

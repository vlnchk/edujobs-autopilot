# Non-secret local references only. Do not commit a filled environment file.
# Export all four Google/Telegram credential ID/name variables before building.
# The builder does not load .env files and fails on missing/blank references.
# For a portable credential-free export, use an explicit separate path:
# node n8n/build-workflow-b.mjs /tmp/workflow-b-run-import.json --credential-free
# Select existing Google/Telegram credentials in n8n after importing that file.
# Same canonical variable names as Workflow A.
GOOGLE_SHEETS_DOCUMENT_ID=
GOOGLE_SHEETS_SHEET_NAME=Applications
N8N_GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID=
N8N_GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_NAME=

WORKFLOW_B_REVIEW_QUEUE_TAB=Review Queue
WORKFLOW_B_ARCHIVE_TAB=Archive
WORKFLOW_B_CONTROL_TAB=Control
WORKFLOW_B_BATCHES_TAB=Publication Batches
WORKFLOW_B_ITEMS_TAB=Publication Batch Items
WORKFLOW_B_CLAIM_TAB=_Workflow B Claim
WORKFLOW_B_CONTROL_CELL=B2

# O-005: only Original Link is used. No selector or fallback is required.
# Legacy WORKFLOW_B_DETAILS_LINK_COLUMN=Original Link is still accepted.
# Any other nonempty value fails explicitly.
# Visible characters (Workflow A Section 13.0.1; URLs and Markdown syntax do not count).
# The same variable is Workflow A's soft editorial budget; keep both values equal.
MAX_PUBLICATION_DESCRIPTION_CHARS=900
WORKFLOW_B_VERSION=workflow-b-presentation-v5
WORKFLOW_B_CONFIG_VERSION=presentation-v5

# Modes: run (default; create and publish OR retry existing frozen batch), setup (fresh bootstrap).
# One-time migration: explicitly replace old prepare/publish with run and reload
# the test n8n runtime environment. Legacy values stop before I/O; never auto-send.
# Workflow remains inactive. Start only one execution at a time.
# A batch observed as PUBLISHING stops with BATCH_ALREADY_PUBLISHING.
WORKFLOW_B_MODE=run
# n8n runtime must permit the above environment references in Code nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# M3: bind the same existing bot reference to Get Chat, Get Administrators and Send.
# These references are consumed by the builder; never place bot secrets here.
N8N_TELEGRAM_CREDENTIAL_ID=
N8N_TELEGRAM_CREDENTIAL_NAME=
# Runtime: fixed numeric channel ID (-100...), stable positive numeric bot user ID.
WORKFLOW_B_TELEGRAM_CHAT_ID=
WORKFLOW_B_TELEGRAM_EXPECTED_BOT_ID=
# run processes at most one batch; existing CREATED/FAILED bypass creation control.
# After a failure, manually delete ALL Telegram messages from that attempt before
# executing run again without further mode changes. Retry uses the same
# frozen batch from START, clearing delivery metadata only after preflight passes.
# If a crash leaves PUBLISHING, confirm no execution runs in the n8n UI, clean
# Telegram, then manually change the batch to FAILED. Never retry cached nodes.

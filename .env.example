# Replace these values with identifiers for disposable, non-production test data.
WORKFLOW_A_TEST_ROW_NUMBER=REPLACE_WITH_ONE_TEST_ROW_NUMBER
GOOGLE_SHEETS_DOCUMENT_ID=REPLACE_WITH_NON_PRODUCTION_SPREADSHEET_ID
GOOGLE_SHEETS_SHEET_NAME=REPLACE_WITH_NON_PRODUCTION_SHEET_TAB_NAME

# Non-secret references to credentials already created in the target n8n environment.
N8N_GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID=REPLACE_WITH_N8N_GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID
N8N_GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_NAME=REPLACE_WITH_N8N_GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_NAME
N8N_OPENAI_CREDENTIAL_ID=REPLACE_WITH_N8N_OPENAI_CREDENTIAL_ID
N8N_OPENAI_CREDENTIAL_NAME=REPLACE_WITH_N8N_OPENAI_CREDENTIAL_NAME

# Internal service endpoints. Keep these Docker DNS names for the Compose sandbox.
CONTENT_WORKER_URL=http://content-worker:8000
BROWSERLESS_URL=http://browserless:3000/content

# Replace every value with an OpenAI model ID available to the n8n credential.
ELIGIBILITY_MODEL=REPLACE_WITH_ELIGIBILITY_MODEL
EDITOR_MODEL=REPLACE_WITH_EDITOR_MODEL
VALIDATOR_MODEL=REPLACE_WITH_VALIDATOR_MODEL
# Optional reasoning effort for the validator (for example high); empty uses the provider default.
VALIDATOR_REASONING_EFFORT=

# Versions persisted in the selected Sheet row.
WORKFLOW_VERSION=workflow-a-v2.3.1-m7
CONFIG_VERSION=REPLACE_WITH_CONFIG_VERSION

# Worker and large-source safety limits.
FETCH_TIMEOUT_SECONDS=15
MAX_REDIRECTS=3
MAX_DOWNLOAD_BYTES=10000000
MAX_EXTRACTED_CHARS=200000
MAX_LLM_SOURCE_CHARS=50000

# Soft visible-length budget of draft_description, shared with Workflow B.
MAX_PUBLICATION_DESCRIPTION_CHARS=900
